version 1.0.3

depends-on framebuffer-spy:0.3.0
import? framebuffer-spy$getFramebufferAddress
import? framebuffer-spy$getFramebufferConfig
import? framebuffer-spy$refreshFramebuffer

export screenshotHandler
with
    xovi-message-broker$simpleSignal = "takeScreenshot"
    xovi-message-broker$version = 1
end
